DOCTOR_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Places API (New) — server-side only. Do not use NEXT_PUBLIC_ prefix.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=

# Panel de Muévete Seguro (app/panel) — el anon key es público/seguro de
# exponer al navegador (mismo criterio que cualquier app cliente de
# Supabase), pero SIEMPRE vía este env var server-side, nunca hardcodeado.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Opcional — default ya apunta al panel-api real si se deja vacío.
PANEL_API_BASE=
